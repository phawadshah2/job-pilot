# Secrets live in ~/.job-pilot/.env, NOT in this repo.
# `python3 -m jobpilot setup --section connect` writes them for you. Keys used:
#   OPENWEBNINJA_API_KEY   JSearch (free plan at openwebninja.com/api/jsearch)
#   RAPIDAPI_KEY           optional legacy alternative for JSearch
#   SHEET_WEBHOOK_URL      Google Apps Script web app URL (ends with /exec)
#   SHEET_TOKEN            shared secret; setup generates it, paste it into Apps Script → Script properties → TOKEN
#   GMAIL_ADDRESS          for reading job-alert emails
#   GMAIL_APP_PASSWORD     a Google *app password* (not your normal password)
