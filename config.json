{
  "_why": "Generic defaults for everyone. Personal choices (role, regions, skills, companies) come from ~/.job-pilot/user.json via `jobpilot setup`.",
  "follow_up_days": 7,
  "sources": {
    "himalayas": true,
    "remotive": true,
    "remoteok": true,
    "jobicy": true,
    "greenhouse": true,
    "lever": true,
    "ashby": true,
    "workable": true,
    "smartrecruiters": true,
    "jsearch": true,
    "gmail": true
  },
  "jsearch": {
    "date_posted": "week",
    "monthly_budget": 190,
    "exclude_publishers": [
      "USA Remote Jobs MySmartPros",
      "Remote Jobs USA",
      "Remote Quest Jobs",
      "HireClip"
    ]
  },
  "gmail": {
    "_why": "Job-alert emails read over IMAP with GMAIL_ADDRESS + GMAIL_APP_PASSWORD from .env; processed alerts are marked read.",
    "query": "newer_than:7d is:unread (from:jobalert.indeed.com OR from:jobalerts-noreply@linkedin.com OR from:bayt.com OR from:gulftalent.com OR from:naukrigulf.com)"
  },
  "blocklist": {
    "_why": "Reposting/spam feeds seen in JSearch results (2026-10-11). Substring match, case-insensitive. `jobpilot clean` re-applies it to stored New jobs.",
    "companies": [
      "vmysmartpros",
      "remotepromsp",
      "remote quest jobs",
      "hireclip"
    ],
    "sources": [
      "mysmartpros",
      "remote jobs usa",
      "remote quest jobs",
      "hireclip"
    ],
    "url_patterns": [
      "mysmartpros\\.com",
      "dedyn\\.io",
      "10001mb\\.com"
    ]
  },
  "find": {
    "prepare_top": 12,
    "prepare_min_score": 70,
    "email_jd_lookups": 6
  },
